<resources>
    <string name="screenshot_protection_title">Screenshots &amp; recording</string>
    <string name="screenshot_protection_intro">
        Apps are marked 'Not allowed' once they hide a screen from screenshots. Apps you have not opened yet show
       'Allowed' until then. You can change either setting.
    </string>
    <string name="screenshot_protection_confirm">
        %1$s will appear in screenshots, screen recordings, screen sharing and casting (sharing and recording
        apps still need your permission each time), and in the Recents preview. Protected videos and DRM content may still
        appear black.
    </string>
    <string name="screenshot_protection_allow">Allow</string>
    <string name="screenshot_protection_cancel">Cancel</string>
    <string name="screenshot_protection_allowed">Allowed</string>
    <string name="screenshot_protection_not_allowed">Not allowed</string>
    <string name="screenshot_protection_admin_disabled">
        Your administrator has disabled screen capture for this user.
    </string>
    <string name="screenshot_protection_unavailable">
        These controls are temporarily unavailable. Please reopen this screen to try again.
    </string>
    <string name="screenshot_protection_save_failed">
        The change could not be confirmed. Please check the setting and try again.
    </string>
    <string name="screenshot_protection_search">Search apps</string>
    <string name="screenshot_protection_no_apps">No apps found.</string>
    <string name="screenshot_protection_allowed_changed">Allowed · Changed by you</string>
    <string name="screenshot_protection_not_allowed_changed">Not allowed · Changed by you</string>
    <string name="screenshot_protection_dont_show_again">Don\'t show again</string>
</resources>
