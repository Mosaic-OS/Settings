<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="status_bar_settings_screen"
    android:title="@string/status_bar_settings">

    <com.android.settings.CustomListPreference
        android:key="status_bar_quick_qs_pulldown"
        app:iconSpaceReserved="false"
        android:title="@string/quick_pulldown_title"
        android:summary="%s"
        android:defaultValue="0"
        android:dialogTitle="@string/quick_pulldown_title"
        android:entries="@array/status_bar_quick_qs_pulldown_entries"
        android:entryValues="@array/status_bar_quick_qs_pulldown_values" />

    <PreferenceScreen
        android:fragment="com.android.settings.statusbar.NetworkTrafficSettingsFragment"
        android:key="network_traffic_settings"
        app:iconSpaceReserved="false"
        android:title="@string/network_traffic_settings_title"
        android:summary="@string/network_traffic_settings_summary" />

    <PreferenceCategory
        android:key="status_bar_icons_category"
        app:iconSpaceReserved="false"
        android:title="@string/status_bar_custom_icons">

        <PreferenceScreen
            android:fragment="com.android.settings.statusbar.SystemIconsSettingsFragment"
            android:key="status_bar_system_icons"
            app:iconSpaceReserved="false"
            android:title="@string/status_bar_custom_system_icons"
            android:summary="@string/status_bar_custom_system_icons_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="status_bar_clock_category"
        app:iconSpaceReserved="false"
        android:title="@string/status_bar_custom_clock">

        <androidx.preference.ListPreference
            android:key="status_bar_clock_position"
            app:iconSpaceReserved="false"
            android:title="@string/status_bar_custom_clock_position"
            android:dialogTitle="@string/status_bar_custom_clock_position"
            android:summary="%s"
            android:persistent="false" />

        <com.android.settingslib.widget.AppSwitchPreference
            android:key="clock_seconds"
            app:iconSpaceReserved="false"
            android:title="@string/status_bar_custom_clock_seconds"
            android:persistent="false" />

    </PreferenceCategory>

</PreferenceScreen>
